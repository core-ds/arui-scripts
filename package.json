{
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "@changesets/changelog-github": "^0.4.8",
        "@changesets/cli": "^2.26.2",
        "arui-presets-lint": "11.8.0",
        "conventional-changelog-cli": "3.0.0",
        "eslint": "9.39.5",
        "prettier": "3.9.10",
        "turbo": "2.9.14"
    },
    "scripts": {
        "publish-packages": "yarn test && changeset version && yarn npm-publish",
        "npm-publish": "yarn workspaces foreach --all --no-private npm publish --access public --tolerate-republish && yarn changeset tag",
        "build": "turbo run build",
        "test": "turbo run build build:app test validate",
        "test:start": "turbo run build --filter=example... && node packages/arui-scripts/test-start.js",
        "lint": "yarn lint:scripts && yarn lint:styles && yarn format:check && yarn lint:unused && yarn lint:secrets",
        "lint:scripts": "eslint",
        "lint:styles": "arui-presets-lint styles",
        "format": "arui-presets-lint format",
        "format:check": "arui-presets-lint format:check",
        "lint:unused": "arui-presets-lint knip",
        "lint:secrets": "arui-presets-lint secretlint",
        "lint:fix": "yarn lint:scripts --fix && yarn lint:styles --fix && yarn format"
    },
    "prettier": "arui-presets-lint/prettier",
    "stylelint": {
        "extends": "arui-presets-lint/stylelint"
    },
    "commitlint": {
        "extends": [
            "./node_modules/arui-presets-lint/commitlint"
        ]
    },
    "packageManager": "yarn@4.13.0"
}
