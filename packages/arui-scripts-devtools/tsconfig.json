{
    "extends": "../arui-scripts/tsconfig.json",
    "compilerOptions": {
        "incremental": false,
        "target": "ES2016",
        "module": "commonjs",
        // automatic-рантайм вместо classic из базового конфига: React в панели — приватная
        // копия, и файлы не должны требовать `import React` ради JSX
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "outDir": "./build",
        "declaration": true,
        "rootDir": "./src",
        "lib": ["ES2016", "DOM", "DOM.Iterable"],
        "types": ["jest", "node"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    // src/extension - само расширение, а не публичный код пакета: его собирает
    // scripts/bundle-extension.js, а tsc-эмит только мешал бы, занимая тот же build/extension
    "exclude": ["build", "src/**/__tests__/**", "src/extension/**"]
}
