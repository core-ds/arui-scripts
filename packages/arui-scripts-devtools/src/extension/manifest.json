{
    "manifest_version": 3,
    "name": "arui devtools",
    "version": "0.1.0",
    "description": "Отладка модулей arui-scripts: загрузки, стадии, события шины, share scope и подмена на localhost",
    "devtools_page": "devtools.html",
    "minimum_chrome_version": "96",
    "permissions": ["declarativeNetRequest"],
    "optional_host_permissions": ["http://*/*", "https://*/*"],
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "homepage_url": "https://github.com/core-ds/arui-scripts/tree/master/packages/arui-scripts-devtools"
}
