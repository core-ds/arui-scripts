{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // в пакете нет "type": "module", поэтому nodenext собирает CommonJS;
        // резолвер node10 удалён в TS 7, а результат сборки с nodenext тот же
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "outDir": "./build/cjs"
    },
    // здесь, в отличие от ESM-сборки, собирается и bin: именно он ставится как исполняемый файл
    "exclude": ["build", "src/__tests__"]
}
